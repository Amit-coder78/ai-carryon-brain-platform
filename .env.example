DATABASE_URL=postgresql://brain:brain@localhost:5432/brain
API_PORT=3000
ENGINE_PORT=8001
# Optional package signing (see README, Phase 7). Not read by the API unless exported in its shell.
# BRAIN_SIGNING_KEY=          # from `make signing-key`; never commit it
# BRAIN_TRUSTED_KEYS=         # comma-separated key ids you trust (your own key is always trusted)
# BRAIN_REQUIRE_SIGNATURE=1   # refuse unsigned or untrusted-signer packages on import
