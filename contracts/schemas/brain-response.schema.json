{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standard Brain response",
  "type": "object",
  "required": ["execution_id", "brain_id", "brain_version_id", "status", "recommendations", "created_at"],
  "properties": {
    "execution_id": {"type": "string", "format": "uuid"},
    "brain_id": {"type": "string", "format": "uuid"},
    "brain_version_id": {"type": "string", "format": "uuid"},
    "status": {"enum": ["ok", "partial", "timeout", "error"]},
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "score"],
        "properties": {
          "candidate_id": {"type": "string"},
          "score": {"type": "number"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "reason_codes": {"type": "array", "items": {"type": "string"}},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
